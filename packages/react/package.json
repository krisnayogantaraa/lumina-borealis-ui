{
  "name": "@lumina-borealis/react",
  "version": "0.2.2",
  "description": "Lumina Borealis UI components for React",
  "type": "module",
  "main": "./dist/lumina-borealis-react.umd.cjs",
  "module": "./dist/lumina-borealis-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lumina-borealis-react.js",
      "require": "./dist/lumina-borealis-react.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npx vite build && npx tsc --emitDeclarationOnly",
    "dev": "npx vite build --watch",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  },
  "keywords": [
    "lumina-borealis",
    "react",
    "ui",
    "component-library"
  ],
  "license": "MIT"
}
