{
  "name": "@lumina-borealis/vue",
  "version": "0.1.0",
  "description": "Lumina Borealis UI components for Vue 3",
  "type": "module",
  "main": "./dist/lumina-borealis-vue.umd.cjs",
  "module": "./dist/lumina-borealis-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lumina-borealis-vue.js",
      "require": "./dist/lumina-borealis-vue.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npx vite build && npx vue-tsc --emitDeclarationOnly",
    "dev": "npx vite build --watch",
    "clean": "rimraf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@lumina-borealis/core": "*"
  },
  "devDependencies": {
    "@lucide/vue": "^1.16.0",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/blocks": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@storybook/vue3": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "storybook": "^10.4.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "lumina-borealis",
    "vue",
    "ui",
    "component-library"
  ],
  "license": "MIT"
}
